# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://aether:password@localhost:5432/aether
PRODUCT_NAME=Aether
LOG_LEVEL=INFO
# Rate limits (Django REST Framework syntax)
THROTTLE_ANON=30/min
THROTTLE_USER=120/min
THROTTLE_AUTH=10/min
# Optional: template DB (with pgvector installed) used to create the test database
DATABASE_TEST_TEMPLATE=

# --- AI providers (configure at least one) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional preferred default model id, e.g. claude-sonnet-5-5 or gemini-flash-latest
DEFAULT_MODEL=
PROVIDER_TIMEOUT_SECONDS=300

# --- Limits and cost controls ---
MAX_USER_MESSAGE_CHARS=32000
MAX_OUTPUT_TOKENS=8192
MAX_CONTEXT_TOKENS=60000
USER_GENERATIONS_PER_MINUTE=12
USER_DAILY_TOKEN_LIMIT=500000
USER_MONTHLY_COST_LIMIT_USD=10.00
# Deployment-wide monthly cap in USD; empty = no global cap
GLOBAL_MONTHLY_COST_LIMIT_USD=
