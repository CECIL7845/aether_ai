# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://aether:password@localhost:5432/aether
PRODUCT_NAME=Aether
LOG_LEVEL=INFO
# Rate limits (Django REST Framework syntax)
THROTTLE_ANON=30/min
THROTTLE_USER=120/min
THROTTLE_AUTH=10/min
# Optional: template DB (with pgvector installed) used to create the test database
DATABASE_TEST_TEMPLATE=

# --- AI providers (configure at least one) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional preferred default model id, e.g. claude-sonnet-5-5 or gemini-flash-latest
DEFAULT_MODEL=
PROVIDER_TIMEOUT_SECONDS=300

# --- Limits and cost controls ---
MAX_USER_MESSAGE_CHARS=32000
MAX_OUTPUT_TOKENS=8192
MAX_CONTEXT_TOKENS=60000
USER_GENERATIONS_PER_MINUTE=12
USER_DAILY_TOKEN_LIMIT=500000
USER_MONTHLY_COST_LIMIT_USD=10.00
# Deployment-wide monthly cap in USD; empty = no global cap
GLOBAL_MONTHLY_COST_LIMIT_USD=

# --- Background tasks ---
# Default: database queue (run `uv run python manage.py db_worker`). Tests use the immediate backend.
TASK_BACKEND=django_tasks_db.DatabaseBackend

# --- Documents ---
MEDIA_ROOT=
MAX_UPLOAD_MB=20
MAX_DOCUMENTS_PER_USER=200
MAX_STORAGE_MB_PER_USER=500
MAX_PDF_PAGES=600
# "gemini" (needs GEMINI_API_KEY) or "none" for keyword-only search
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
FULL_CONTEXT_MAX_CHARS=60000
RETRIEVAL_TOP_K=8
